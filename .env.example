# ---------------------------------------------------------------------------
# AutoOps AI - environment configuration
# Copy this file to .env and adjust as needed. The stack runs end-to-end with
# no changes (LLM_PROVIDER=mock requires no API key).
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
POSTGRES_USER=autoops
POSTGRES_PASSWORD=autoops
POSTGRES_DB=autoops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://autoops:autoops@postgres:5432/autoops

# --- Backend ------------------------------------------------------------
BACKEND_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Simulator ------------------------------------------------------------
SIMULATOR_URL=http://simulator:9000
SIMULATOR_PORT=9000

# --- LLM provider -----------------------------------------------------------
# One of: mock | openai | anthropic
# "mock" is fully deterministic and requires no API key - this is the default
# demo mode. The agent still calls all real tools and reasons over real data;
# only the "model" producing the final diagnosis text is replaced.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Safety / remediation policy --------------------------------------------
# When true, MEDIUM risk actions (restart, scale) execute automatically
# without human approval. HIGH risk actions (rollback) ALWAYS require
# approval regardless of this flag.
SAFE_AUTO_REMEDIATION=false
MAX_REMEDIATION_ATTEMPTS_PER_INCIDENT=3

# --- Telemetry polling --------------------------------------------------
TELEMETRY_POLL_INTERVAL_SECONDS=5
ERROR_RATE_ALERT_THRESHOLD=0.15
LATENCY_ALERT_THRESHOLD_MS=800

# --- Notifications (optional) ------------------------------------------------
SLACK_WEBHOOK_URL=

# --- Frontend -----------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# --- Grafana ------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
